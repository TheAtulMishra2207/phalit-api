# Phalit.ai · Environment variables template
#
# This file documents which env vars Phalit needs at runtime.
# It is SAFE to commit to git — it contains no real secrets, only placeholders.
#
# In production: set these in Render.com → service → Environment tab.
# In local dev:  copy this file to `.env` (without the `.example`) and fill in
#                real values. The `.env` file is gitignored — never commit it.

# ----- Supabase -----
# Project URL — find at Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — find at Supabase → Project Settings → API
# Safe to expose in frontend code
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Secret key — find at Supabase → Project Settings → API (reveal toggle)
# NEVER expose in frontend code or commit to git
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# ----- JWT verification tuning (optional, defaults shown) -----
JWT_CACHE_TTL_SECONDS=900
JWT_HTTP_TIMEOUT_SECONDS=5.0

# ----- Environment -----
# One of: development, staging, production
PHALIT_ENV=production
